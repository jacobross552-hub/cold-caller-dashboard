# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored. NEVER put real keys in this file (.env.example).
# ---------------------------------------------------------------------------

# --- Dashboard login -------------------------------------------------------
# The password you type to open the dashboard. Pick anything you'll remember.
DASHBOARD_PASSWORD=
# Random string used to sign your login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- ElevenLabs ------------------------------------------------------------
# elevenlabs.io -> profile menu -> API Keys
ELEVENLABS_API_KEY=
# elevenlabs.io/app/agents -> your agent -> the ID in the URL / settings
ELEVENLABS_AGENT_ID=
# elevenlabs.io/app/agents/phone-numbers -> the imported Twilio number's ID
ELEVENLABS_PHONE_NUMBER_ID=
# Shown once when you create the post-call webhook in ElevenLabs settings.
ELEVENLABS_WEBHOOK_SECRET=

# --- Anthropic (writes the plain-English summaries and pre-call briefs) -----
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- Twilio (texts you when a meeting books) -------------------------------
# console.twilio.com -> Keys & Credentials -> API keys & tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that sends the alert (your AU mobile).
TWILIO_FROM_NUMBER=
# Where booking alerts go — your personal mobile.
ALERT_TO_NUMBER=

# --- Calling behaviour -----------------------------------------------------
# Hard cap on calls dispatched per calendar day (Australia/Sydney).
MAX_CALLS_PER_DAY=250
# How many calls to hand ElevenLabs per dispatch tick.
DISPATCH_CHUNK_SIZE=5
# How many calls ElevenLabs may run at once.
CALL_CONCURRENCY=2
# Set to "true" ONLY to test outside legal calling hours with your own number.
# Leave unset/false in normal use — this bypasses the calling-hours guard.
ALLOW_OUTSIDE_CALLING_HOURS=false

# --- Lead finder -----------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials.
# The project needs "Places API (New)" enabled AND billing switched on.
# Google's first 1,000 Enterprise searches a month are free, which is far more
# than this dashboard uses — but billing must still be enabled or every call
# comes back 403.
GOOGLE_PLACES_API_KEY=
# Free, instant registration at abr.business.gov.au/Tools/WebServices
# Optional. Without it, businesses can't be checked against the business
# register, so fewer sole-trader mobile numbers make it through the guard.
ABN_LOOKUP_GUID=
# Ceiling on one run, so a mistyped 5000 can't become a 5000-lead run.
MAX_LEADS_PER_RUN=200
# Ceiling on one run's spend, in AUD. Checked before the run starts AND again
# before every API call, so a bad hit rate can't walk past the budget.
MAX_COST_PER_RUN_AUD=25
# Google bills in USD; the dashboard shows AUD. The rate in force is stamped
# onto each run, so changing this never rewrites the cost of a past run.
USD_AUD_RATE=1.55

# --- Storage ---------------------------------------------------------------
# Where the SQLite database file lives. On Railway, point this at a volume.
DATABASE_PATH=./data/dashboard.db

# --- Cost accounting -------------------------------------------------------
# The Costs page sums real spend from recorded events wherever it can.
#
# There are deliberately NO Twilio rate variables. Twilio exposes both its
# account-specific rates and the actual charged amounts through its API, using
# the credentials above — so the dashboard reads the real figures rather than a
# rate typed here, which would be wrong for most calls (AU landline is
# $0.0252/min against $0.0750/min for mobile) and would go stale silently.

# --- ElevenLabs plan -------------------------------------------------------
# What ElevenLabs actually charges each month, INCLUDING tax. Creator is $22
# base + 10% GST = $24.20. Billed in USD.
ELEVENLABS_PLAN_MONTHLY_USD=24.20
# Agent-minutes the plan includes, and the rate beyond them. Minutes inside the
# pool are NOT cash — the plan fee above already paid for them, and the invoice
# reads $0.00 until the pool is exceeded. Counting them as spend would overstate
# the bill by the value of the whole pool every month.
ELEVENLABS_INCLUDED_MINUTES_PER_MONTH=275
ELEVENLABS_OVERAGE_USD_PER_MIN=0.08
# Day of the month the billing period rolls over.
ELEVENLABS_BILLING_ANCHOR_DAY=13
# Left blank on purpose. The plan includes some LLM allowance but the console
# doesn't state it, so agent-LLM usage is reported as metered value and kept out
# of the cash total rather than guessed at. Fill in only if you learn the real
# figure.
ELEVENLABS_INCLUDED_LLM_USD_PER_MONTH=

# --- Railway ---------------------------------------------------------------
# Trial workspace: a ONE-TIME credit grant, no card on file, no recurring fee.
# The monthly cost is genuinely zero — do not put the grant here, it is not a
# subscription and booking it monthly would invent a recurring charge.
RAILWAY_MONTHLY_USD=0
# The grant, and the usage reading you last took off railway.com/workspace/usage.
# These drive the runway panel: burn per day is computed from the reading, and
# the projected exhaustion date follows from that. Railway shuts deployments
# down when credits run out, so this is an uptime risk, not a cost line.
RAILWAY_CREDIT_GRANT_USD=5.00
RAILWAY_CREDITS_USED_USD=0.0704
RAILWAY_CREDITS_OBSERVED_AT=2026-08-20

# --- Twilio number ---------------------------------------------------------
# Which rental rate to read off Twilio's pricing API. The number in use is an
# AU mobile (04xx), which rents for more than a local number.
TWILIO_NUMBER_COUNTRY=AU
TWILIO_NUMBER_TYPE=mobile

# Optional. Overrides the "running since" date, which is otherwise the earliest
# thing in the database. ISO date, e.g. 2026-08-17.
COSTS_SINCE=

# --- Stripe (READ-ONLY reconciliation) --------------------------------------
# dashboard.stripe.com -> Developers -> API keys -> Secret key.
# The dashboard never writes to Stripe — no invoices, no charges, no
# subscriptions. It only reads back what was actually paid, to check against
# the price recorded on each Won deal. Without this, the finance page's
# revenue line is what you RECORDED when marking a deal Won, not what Stripe
# confirms was received.
STRIPE_SECRET_KEY=
