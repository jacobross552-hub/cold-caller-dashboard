# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored. NEVER put real keys in this file (.env.example).
# ---------------------------------------------------------------------------

# --- Dashboard login -------------------------------------------------------
# The password you type to open the dashboard. Pick anything you'll remember.
DASHBOARD_PASSWORD=
# Random string used to sign your login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- ElevenLabs ------------------------------------------------------------
# elevenlabs.io -> profile menu -> API Keys
ELEVENLABS_API_KEY=
# elevenlabs.io/app/agents -> your agent -> the ID in the URL / settings
ELEVENLABS_AGENT_ID=
# elevenlabs.io/app/agents/phone-numbers -> the imported Twilio number's ID
ELEVENLABS_PHONE_NUMBER_ID=
# Shown once when you create the post-call webhook in ElevenLabs settings.
ELEVENLABS_WEBHOOK_SECRET=

# --- Anthropic (writes the plain-English summaries and pre-call briefs) -----
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- Twilio (texts you when a meeting books) -------------------------------
# console.twilio.com -> Keys & Credentials -> API keys & tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that sends the alert (your AU mobile).
TWILIO_FROM_NUMBER=+61480846881
# Where booking alerts go — your personal mobile.
ALERT_TO_NUMBER=+61491175724

# --- Calling behaviour -----------------------------------------------------
# Hard cap on calls dispatched per calendar day (Australia/Sydney).
MAX_CALLS_PER_DAY=20
# How many calls to hand ElevenLabs per dispatch tick.
DISPATCH_CHUNK_SIZE=5
# How many calls ElevenLabs may run at once.
CALL_CONCURRENCY=2
# Set to "true" ONLY to test outside legal calling hours with your own number.
# Leave unset/false in normal use — this bypasses the calling-hours guard.
ALLOW_OUTSIDE_CALLING_HOURS=false

# --- Lead finder -----------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials.
# The project needs "Places API (New)" enabled AND billing switched on.
# Google's first 1,000 Enterprise searches a month are free, which is far more
# than this dashboard uses — but billing must still be enabled or every call
# comes back 403.
GOOGLE_PLACES_API_KEY=
# Free, instant registration at abr.business.gov.au/Tools/WebServices
# Optional. Without it, businesses can't be checked against the business
# register, so fewer sole-trader mobile numbers make it through the guard.
ABN_LOOKUP_GUID=
# Ceiling on one run, so a mistyped 5000 can't become a 5000-lead run.
MAX_LEADS_PER_RUN=200
# Ceiling on one run's spend, in AUD. Checked before the run starts AND again
# before every API call, so a bad hit rate can't walk past the budget.
MAX_COST_PER_RUN_AUD=25
# Google bills in USD; the dashboard shows AUD. The rate in force is stamped
# onto each run, so changing this never rewrites the cost of a past run.
USD_AUD_RATE=1.55

# --- Storage ---------------------------------------------------------------
# Where the SQLite database file lives. On Railway, point this at a volume.
DATABASE_PATH=./data/dashboard.db
