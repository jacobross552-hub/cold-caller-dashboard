{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here only for the fetch/RequestInit types the calling modules use.
    // Nothing in the test build touches a browser API.
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  // Only modules with no database or React dependency belong here — these are
  // compiled to plain CommonJS and run under bare node.
  "include": [
    "src/lib/calling-hours.ts",
    "src/lib/holidays.ts",
    "src/lib/env.ts",
    "src/lib/phone.ts",
    "src/lib/timezones.ts",
    "src/lib/calendar-event.ts",
    "src/lib/outcomes.ts",
    "src/lib/pricing.ts",
    "src/lib/elevenlabs.ts",
    "src/lib/sms.ts",
    "src/lib/brief.ts",
    "src/lib/calls.ts",
    "src/lib/dispatcher.ts",
    "src/lib/db.ts",
    "src/lib/leads.ts",
    "src/lib/suppression.ts",
    "src/lib/lead-finder/cost.ts",
    "src/lib/lead-finder/hours.ts",
    "src/lib/lead-finder/icp.ts",
    "src/lib/lead-finder/queries.ts",
    "src/lib/lead-finder/abn.ts",
    "src/lib/lead-finder/places.ts",
    "src/lib/lead-finder/source.ts",
    "src/lib/lead-finder/runs.ts",
    "src/lib/lead-finder/orchestrator.ts",
    "scripts/**/*.ts"
  ]
}
