{
  "name": "cold-caller-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "npm run test:hours && npm run test:leads && npm run test:import && npm run test:run && npm run test:calendar && npm run test:integration && npm run test:costs && npm run test:deals && npm run test:finance && npm run test:demo-agent && npm run test:learning && npm run test:elevenlabs-agents && npm run test:demo-booking",
    "test:hours": "tsc -p tsconfig.test.json && node .test-build/scripts/test-calling-hours.js",
    "test:leads": "tsc -p tsconfig.test.json && node .test-build/scripts/test-lead-finder.js",
    "test:import": "tsc -p tsconfig.test.json && node .test-build/scripts/test-lead-import.js",
    "test:run": "tsc -p tsconfig.test.json && node .test-build/scripts/test-lead-run.js",
    "check:creds": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env .test-build/scripts/check-credentials.js",
    "test:calendar": "tsc -p tsconfig.test.json && node .test-build/scripts/test-calendar-event.js",
    "test:integration": "tsc -p tsconfig.test.json && node .test-build/scripts/test-integration.js",
    "test:costs": "tsc -p tsconfig.test.json && node .test-build/scripts/test-costs.js",
    "test:deals": "tsc -p tsconfig.test.json && node .test-build/scripts/test-deals.js",
    "test:finance": "tsc -p tsconfig.test.json && node .test-build/scripts/test-finance.js",
    "test:demo-agent": "tsc -p tsconfig.test.json && node .test-build/scripts/test-demo-agent.js",
    "test:learning": "tsc -p tsconfig.test.json && node .test-build/scripts/test-learning.js",
    "test:elevenlabs-agents": "tsc -p tsconfig.test.json && node .test-build/scripts/test-elevenlabs-agents.js",
    "test:demo-booking": "tsc -p tsconfig.test.json && node .test-build/scripts/test-demo-booking.js",
    "backfill:costs": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env .test-build/scripts/backfill-costs.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@elevenlabs/elevenlabs-js": "^2.64.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.8.3"
  }
}
